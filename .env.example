# ---------------------------------------------------------------------------
# FGPOWER environment variables
# Copy to .env for local development. In production (Railway) set these as
# service variables. Never commit a real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://fgpower:fgpower@localhost:5433/fgpower?schema=public"

# better-auth: random 32+ byte secret (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Public origin of the app, no trailing slash (e.g. https://fgpower.up.railway.app)
BETTER_AUTH_URL="http://localhost:3000"
# The app's public origin (see "Batch 5" below).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.0 (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated e-mails granted admin access (in addition to any user
# whose role is already "admin" via the better-auth admin plugin): /admin,
# the sidebar's "Admin" link, Settings' "Painel admin" and the report alerts.
ADMIN_EMAILS=""

# ---------------------------------------------------------------------------
# Batch 5 — every feature below hides itself while its variables are missing.
# NEXT_PUBLIC_APP_URL (above) is also the origin of e-mail/push links, share
# previews and metadataBase: set it at BUILD time on Railway
# (https://fgpower.monster); unset in production it falls back to that.
# ---------------------------------------------------------------------------

# E-mail (login by e-mail + code, the weekly digest, admin report alerts),
# sent through Resend's REST API (no SDK). Needs a Resend account and a
# verified sending domain. Without RESEND_API_KEY and EMAIL_FROM: off in
# production (nothing e-mail related is shown); outside production a dev
# transport logs each message to the EmailMessage table (/api/test/outbox).
RESEND_API_KEY=""
# e.g. FGPOWER <acesso@fgpower.monster>
EMAIL_FROM=""
# Optional.
EMAIL_REPLY_TO=""
# Optional override: resend | dev | off ("dev" is never used in production).
EMAIL_TRANSPORT=""
# Optional: Resend webhook signing secret (whsec_…) for bounces and complaints
# (endpoint: /api/email/webhook, events email.bounced and email.complained).
RESEND_WEBHOOK_SECRET=""
# Optional: sign-in codes all addresses may receive per 24 h (default 80).
# Keep it under the Resend plan's daily quota (the free tier sends ~100 a day),
# which the weekly digest shares. Each address: 5 an hour, 10 a day.
LOGIN_CODES_DAILY_BUDGET=""

# Web Push reminders. No external account: generate the pair with
#   npx web-push generate-vapid-keys
# The server reads the public key per request and hands it to the page as a
# prop: there is no NEXT_PUBLIC_ copy (a rotated key needs no rebuild).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact for the push services: mailto:<an admin address> or https://fgpower.monster
VAPID_SUBJECT=""
# Optional override: webpush | dev | off ("dev" is refused in production).
PUSH_TRANSPORT=""

# Reminder scheduler: an in-process 5-minute tick (src/instrumentation.ts)
# that POSTs /api/cron/reminders over loopback with "Authorization: Bearer
# $CRON_SECRET". Set REMINDER_SCHEDULER=on on the production web service
# only — never on a shared dev server. CRON_SECRET: openssl rand -base64 32.
REMINDER_SCHEDULER=""
CRON_SECRET=""

# Optional: key for signed e-mail links (unsubscribe, tracked clicks).
# Falls back to BETTER_AUTH_SECRET.
LINK_SIGNING_SECRET=""

# Nothing else to set for E2E: outside NODE_ENV=production, better-auth's
# email/password provider and the /api/test/login route are both
# automatically available (see e2e/fixtures.ts). Neither exists in production.
